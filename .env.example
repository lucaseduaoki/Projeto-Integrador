# ============================================================================
# VARIÁVEIS DE AMBIENTE - FreelaJá Platform
# ============================================================================
# Copie este arquivo para .env e configure com seus valores reais
# Não commitar .env no repositório (adicionar ao .gitignore)

# ============================================================================
# AMBIENTE DA APLICAÇÃO
# ============================================================================
APP_ENV=development

# ============================================================================
# CONFIGURAÇÕES DO BANCO DE DADOS MYSQL
# ============================================================================
# Senha do usuário root do MySQL
MYSQL_ROOT_PASSWORD=root_password_change_me

# Nome do banco de dados
MYSQL_DATABASE=freelaja

# Usuário do MySQL (não-root)
MYSQL_USER=freelaja

# Senha do usuário MySQL
MYSQL_PASSWORD=mysql_password_change_me

# ============================================================================
# CONFIGURAÇÕES DO SERVIDOR (Opcionais - usam padrões se não definidos)
# ============================================================================
# HOST do banco de dados (padrão: mysql)
DB_HOST=mysql

# Porta do banco de dados (padrão: 3306)
DB_PORT=3306

# ============================================================================
# CONFIGURAÇÕES DA APLICAÇÃO PHP (Opcionais)
# ============================================================================
# URL base da aplicação
# URL_BASE=http://localhost:8080

# Nome da aplicação
# APP_NAME=FreelaJá
